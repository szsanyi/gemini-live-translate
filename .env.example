# GEMINI_API_KEY: Required for Gemini Live Translation models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for the OpenAI Realtime Translation model (gpt-realtime-translate).
# Only needed if you want to use the OpenAI option in the model selector.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── AI Summary (the "AI Summary" button) ─────────────────────────────────────
# The summary can run on a different provider/key/model than live translation.
# SUMMARY_PROVIDER: gemini | openai | ollama   (default: gemini)
# SUMMARY_MODEL:    model id (defaults: gemini→gemini-flash-latest,
#                   openai→gpt-4o-mini, ollama→llama3.1)
#                   NOTE: on free-tier Gemini keys only the *-latest aliases have
#                   quota; pinned ids like gemini-2.0-flash fail with 429 limit: 0.
#                   Working alternative: gemini-flash-lite-latest
# SUMMARY_API_KEY:  key for the chosen provider (falls back to GEMINI_API_KEY /
#                   OPENAI_API_KEY; not needed for ollama)
# SUMMARY_BASE_URL: override the endpoint (OpenAI-compatible base or Ollama host;
#                   defaults: openai→https://api.openai.com/v1,
#                   ollama→http://localhost:11434)
#SUMMARY_PROVIDER="gemini"
#SUMMARY_MODEL=""
#SUMMARY_API_KEY=""
#SUMMARY_BASE_URL=""

# ── Save to Obsidian (the "Save to Obsidian" button) ─────────────────────────
# OBSIDIAN_VAULT_DIR: absolute path to the folder where transcript notes are
# written. A per-day subfolder (YYYY-MM-DD) is created inside it, and each note
# is named "<YYYY-MM-DD HH-MM subject>.md" (the subject is generated with AI
# using the SUMMARY_* provider above).
# Default: ./data/vault/meetings (inside the project, works with no config).
# Set this to your real vault to write notes there instead.
#OBSIDIAN_VAULT_DIR="/home/<user>/Documents/Obsidian Vault/meetings/"
